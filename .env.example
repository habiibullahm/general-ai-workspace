# Copy this file to .env.local and fill these values from the Nibie Supabase project.
NEXT_PUBLIC_APP_NAME=Nibie
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Prefer the publishable key. Older Supabase projects may use the public anon-key variable instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy public key name (use one public key variable only):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by Drizzle migrations only. Keep this database credential server-side.
DATABASE_URL=

# Integration tests destructively reset only a loopback database named general_ai_workspace_test.
TEST_DATABASE_URL=
# Explicit opt-in required before the RLS integration test resets its local database.
ALLOW_TEST_DATABASE_RESET=

# Server-only AI provider configuration. Never expose these values to the browser.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_BALANCED=
AI_MODEL_REASONING=
# Optional: comma-separated modes whose model is verified to honour a reasoning effort, e.g. Reasoning. Empty hides the Reasoning control.
AI_REASONING_MODES=

# Dedicated test account; never use a real user's credentials for automated tests.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Optional deployed target; without this, Playwright uses the local dev server.
E2E_BASE_URL=

# Fastify foundation (apps/api). These names are not read by Next.js.
# The foundation process does not receive production traffic.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# APP_ORIGINS=
# API_HOST=127.0.0.1
# API_PORT=4000
# LOG_LEVEL=info
